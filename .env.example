# Copie para .env e preencha. O .env nunca vai para o git.

# Token do bot, obtido com o @BotFather no Telegram.
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Seu chat_id privado. Mande qualquer mensagem ao bot e abra
# https://api.telegram.org/bot<TOKEN>/getUpdates para ver "chat":{"id":...}
TELEGRAM_CHAT_ID=123456789
